# Backend
# Host-side tools (alembic, pytest) reach Postgres/Redis on the ports published by compose.yaml.
# Inside containers compose injects the service-DNS URLs (db/redis) instead — these values are
# only used by processes running directly on your machine.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0
TRIAGE_PROVIDER=simulated
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://ollama:11434

# Frontend (runtime config served by nginx)
VITE_API_BASE_URL=/api
